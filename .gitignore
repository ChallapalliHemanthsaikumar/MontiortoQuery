# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
certs/
# Virtual environments
venv/
.venv/
env/
vision_server
# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Data (large files, local only)
data/*
!data/.gitkeep

# Environment variables
.env
.env.local

# Terraform
cloud/terraform/.terraform/
cloud/terraform/*.tfstate
cloud/terraform/*.tfstate.backup
cloud/terraform/*.tfvars

# YOLO models (large binaries) — except models/ directory
*.onnx
*.pt
!models/*.onnx
!models/*.pt
!models/*.tflite

# Vision server logs (large JSON)
vision_server/data/events.json

# Logs
*.log

# Experiment output (large files)
experiments/*/output/
experiments/*/video/
experiments/*/frames/
docs/*